import java.util.ArrayList;

class Heap {
    public static void main(String[] args) {
        int[] arr = {42, 7, 19, 3, 25, 11, 8, 31, 2, 15};

        MinHeap<Integer> minHeap = new MinHeap<>();

        for (int num : arr){
            minHeap.insert(num);
        }

        for (int num : arr){
            System.out.println(minHeap.remove());
        }
    }
}

class MinHeap<T extends Comparable<T>> {
    private ArrayList<T> list;

    public MinHeap() {
        list = new ArrayList<>();
    }

    private void swap(int a, int b){
        T temp = list.get(a);
        list.set(a, list.get(b));
        list.set(b, temp);
    }

    private int getParentIndex(int idx){
        return (idx - 1)/2;
    }

    private int leftIndex(int idx){
        return (idx * 2 + 1);
    }

    private int rightIndex(int idx){
        return (idx * 2 + 2);
    }

    public void insert(T value){
        list.add(value);

        upheap(list.size() - 1);
    }

    private void upheap(int idx){
        if (idx == 0){
            return;
        }
        int parentIdx = getParentIndex(idx);

        if (list.get(idx).compareTo(list.get(parentIdx)) < 0){
            swap(idx, parentIdx);
            upheap(parentIdx);
        }
    }

    public T remove(){
        if (list.isEmpty()){
            return null;
        }

        T temp = list.get(0);
        T last = list.remove(list.size() - 1);

        if (!list.isEmpty()){
            list.set(0 , last);
            downheap(0);
        }

        return temp;
    }

    private void downheap(int idx){
        int min = idx;
        int left = leftIndex(idx);
        int right = rightIndex(idx);

        if (left < list.size() && list.get(min).compareTo(list.get(left)) > 0){
            min = left;
        }

        if (right < list.size() && list.get(min).compareTo(list.get(right)) > 0){
            min = right;
        }

        if (min != idx){
            swap(min , idx);
            downheap(min);
        }
    }
}